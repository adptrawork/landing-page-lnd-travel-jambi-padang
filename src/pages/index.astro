---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, routes, notes } from '../data/business';
const cta = `https://wa.me/${business.phone}?text=${encodeURIComponent('Halo, saya mau pesan kursi travel.')}`;
---
<BaseLayout title={business.title} description={business.description} canonicalPath={business.canonicalPath} image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center min-h-[88dvh] py-10">
      <div class="md:col-span-7 reveal">
        <p class="flex items-center gap-2 text-sm font-medium text-emerald-700">
          <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M128 16l36 74 82 12-59 58 14 82-73-38-73 38 14-82-59-58 82-12z"/></svg>
          <span class="font-mono-num">{business.rating}</span>
          <span class="text-zinc-500">• {business.category} • {business.city}</span>
        </p>
        <h1 class="mt-4 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Jambi–Padang Rp280rb, berangkat 16.00 tiap hari</h1>
        <p class="mt-5 text-base text-gray-600 leading-relaxed max-w-[65ch]">LND Lintas Nusa Damai di Jl. TP. Sriwijaya Rawasari. Jambi–Padang Rp280rb berangkat 16.00 WIB, booking 24 jam di 0813-8118-2008. Dilengkapi asuransi, AC dingin, dan driver bersertifikat.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={cta} target="_blank" rel="noopener" class="bg-emerald-700 text-white px-7 py-3.5 rounded-full font-medium hover:-translate-y-0.5">Pesan Kursi via WA</a>
          <a href="/jadwal" class="border border-zinc-300 px-7 py-3.5 rounded-full font-medium hover:border-zinc-950">Lihat Jadwal</a>
        </div>
        <div class="mt-8 flex divide-x divide-zinc-200 border-t border-zinc-200 pt-5 text-sm">
          <div class="pr-6"><p class="font-mono-num font-semibold">{routes.length}</p><p class="text-zinc-500">Rute Aktif</p></div>
          <div class="px-6"><p class="font-mono-num font-semibold">24 jam</p><p class="text-zinc-500">Booking</p></div>
          <div class="pl-6"><p class="font-mono-num font-semibold">9</p><p class="text-zinc-500">Rute Terverifikasi</p></div>
        </div>
      </div>
      <div class="md:col-span-5 reveal">
        <img src="/images/lnd-layanan-1.jpg" alt="Poster LND Travel: layanan travel, paket kilat, dan carter mobil 0813-8118-2008" width="1024" height="1024" loading="eager" fetchpriority="high" class="w-full aspect-square object-cover rounded-[2.5rem] border border-slate-200/50 shadow" />
        <p class="mt-3 text-xs text-zinc-400">Sumber: traveljambipadang.web.id (situs resmi) — ganti foto asli</p>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-8 w-full">
    <p class="text-sm font-medium text-emerald-700">Keunggulan</p>
    <h2 class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold max-w-[20ch]">Kenapa berangkat bersama kami?</h2>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-7 reveal"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 md:p-10 h-full">
        <p class="font-semibold text-lg tracking-tight">Harga terjangkau terverifikasi</p>
        <p class="mt-1 text-base text-gray-600">Sembilan rute dengan tarif resmi: Jambi–Padang Rp280rb, Jambi–Pekanbaru Rp250rb.</p>
      </div></div>
      <div class="md:col-span-5 reveal"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 md:p-10 h-full">
        <p class="font-semibold text-lg tracking-tight">Asuransi perjalanan</p>
        <p class="mt-1 text-base text-gray-600">Penumpang dijamin asuransi selama perjalanan bersama LND.</p>
      </div></div>
      <div class="md:col-span-5 reveal"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 md:p-10 h-full">
        <p class="font-semibold text-lg tracking-tight">Armada terawat</p>
        <p class="mt-1 text-base text-gray-600">Kendaraan aman terawat, interior bersih wangi, AC sehat dan dingin.</p>
      </div></div>
      <div class="md:col-span-7 reveal"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 md:p-10 h-full">
        <p class="font-semibold text-lg tracking-tight">Driver bersertifikat</p>
        <p class="mt-1 text-base text-gray-600">Driver ramah berpengalaman dengan sertifikat resmi, plus layanan paket kilat dan carter.</p>
      </div></div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-12 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-5">
        <p class="text-sm font-medium text-emerald-700">Lokasi & info</p>
        <h2 class="mt-2 text-3xl md:text-4xl tracking-tighter leading-none font-bold">Rating <span class="font-mono-num">{business.rating}</span> — {business.name}</h2>
        <p class="mt-3 text-base text-gray-600">{business.address}. <a class="underline underline-offset-4 text-zinc-900" href={business.mapsUrl} target="_blank" rel="noopener">Lihat di Google Maps</a></p>
        {notes.map((n) => (<p class="mt-3 text-sm text-zinc-500 border-l-2 border-emerald-700 pl-3">{n}</p>))}
        <a href="/kontak" class="mt-5 inline-block underline underline-offset-4 text-sm font-medium">Kontak & FAQ lengkap</a>
      </div>
      <div class="md:col-span-7">
        <div class="rounded-[2.5rem] overflow-hidden border border-slate-200/50 aspect-video bg-zinc-100">
          <iframe title={`Peta ${business.name}`} src={business.mapsEmbed} loading="lazy" class="w-full h-full"></iframe>
        </div>
        <p class="mt-3 text-xs text-zinc-500">{business.address} — {business.hours}</p>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-14 w-full">
    <div class="md:pl-[12vw]">
      <h2 class="text-3xl md:text-4xl tracking-tighter leading-none font-bold max-w-[20ch]">Amankan kursi sebelum penuh</h2>
      <a href={cta} target="_blank" rel="noopener" class="mt-6 inline-block bg-emerald-700 text-white px-8 py-3.5 rounded-full font-medium">Pesan Kursi via WA</a>
    </div>
  </section>
</BaseLayout>
