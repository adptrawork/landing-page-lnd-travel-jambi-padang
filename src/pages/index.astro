---
import BaseLayout from '../layouts/BaseLayout.astro';
import RouteCard from '../components/RouteCard.astro';
import FleetCard from '../components/FleetCard.astro';
import StepsPesan from '../components/StepsPesan.astro';
import TrustBadges from '../components/TrustBadges.astro';
import Faq from '../components/Faq.astro';
import { business, routes, faqs } from '../data/business';
const cta = `https://wa.me/${business.phone}?text=${encodeURIComponent('Halo, saya mau pesan kursi Jambi-Padang.')}`;
const waFor = (name: string) => `https://wa.me/${business.phone}?text=${encodeURIComponent(`Halo LND Travel, saya mau pesan kursi ${name}. Apakah tersedia untuk 16.00?`)}`;
const lead = routes[0];
const extraFaqs = [
  { q: 'Berapa bagasi yang boleh dibawa?', a: 'Ketentuan bagasi tidak dipublikasikan di situs resmi — tanyakan batas koper via WA, terutama jika membawa paket kilat sekalian.' },
  { q: 'Bagaimana refund jika batal berangkat?', a: 'Ketentuan refund tidak dipublikasikan — minta kebijakan pembatalan tertulis via WA sebelum membayar.' },
  { q: 'Di mana titik jemput di Jambi?', a: 'Loket Jl. TP. Sriwijaya, Rawasari, Kota Baru. Konfirmasi titik jemput dan datang 30 menit sebelum 16.00.' },
  { q: 'Apakah berangkat jika penumpang sedikit?', a: 'Keberangkatan 16.00 tiap hari mengikuti kuota kursi — konfirmasi H-1 via WA karena booking dilayani 24 jam.' },
];
---
<BaseLayout title={business.title} description={business.description} canonicalPath={business.canonicalPath} image={business.ogImage}>
  <!-- Ref: Awwwards boarding-pass & ticket-stub print systems — hero tiket jalan malam: headline editorial kiri + panel tiket kanan (perforasi dashed, barcode gradient, label mono) -->
  <section class="hero-section bg-zinc-950 text-zinc-100">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 w-full">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-y-14 md:gap-x-10 items-start pt-12 pb-16 md:pt-20 md:pb-24">
        <div class="md:col-span-6 lg:col-span-7 reveal">
          <p class="inline-flex items-center gap-2.5 border border-white/10 bg-white/5 px-3 py-2 text-[11px] font-mono-num uppercase tracking-[0.2em] text-zinc-300">
            <span class="breathing-dot" aria-hidden="true"></span>
            Boarding 16.00 WIB · tiap hari
          </p>
          <p class="mt-7 mono-label mono-accent">Night service · Jambi → Padang</p>
          <h1 class="mt-4 text-[clamp(2.05rem,8.6vw,4.25rem)] font-black leading-[0.95] tracking-[-0.03em]">
            <span class="block">Tidur di Jambi,</span>
            <span class="block text-red-300">sarapan di Padang</span>
          </h1>
          <div class="mt-7 h-px w-24 bg-red-300/40" aria-hidden="true"></div>
          <p class="mt-6 max-w-[52ch] text-base leading-relaxed text-zinc-400">LND Lintas Nusa Damai — spesialis jalan malam Jambi–Padang, tarif {lead.price}. Asuransi perjalanan, AC dingin, driver bersertifikat, booking 24 jam di {business.phoneDisplay}.</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href={cta} target="_blank" rel="noopener" class="btn-stamp">Pesan Kursi via WA</a>
            <a href="/jadwal" class="mono-label mono-cta underline decoration-red-300/60 decoration-2 underline-offset-[7px] inline-flex min-h-[48px] items-center">Linimasa 9 rute →</a>
          </div>
          <dl class="stat-rail mt-10">
            <div>
              <dt class="mono-label">Rute resmi</dt>
              <dd class="font-mono-num text-2xl font-semibold text-white">{routes.length} jalur</dd>
            </div>
            <div>
              <dt class="mono-label">Booking</dt>
              <dd class="font-mono-num text-2xl font-semibold text-white">24 jam</dd>
            </div>
            <div>
              <dt class="mono-label">Rating</dt>
              <dd class="font-mono-num text-2xl font-semibold text-white">{business.rating}<span class="text-sm font-normal text-zinc-400"> / {business.reviewCount}</span></dd>
            </div>
          </dl>
        </div>
        <div class="md:col-span-6 lg:col-span-5">
          <div class="ticket-wrap ticket-in">
            <div class="ticket-offset" aria-hidden="true"></div>
            <figure class="ticket">
              <div class="ticket-photo refract">
                <img src="/images/lnd-rute-1.webp" alt="Armada LND Travel rute Jambi Padang berangkat 16.00 WIB" width="693" height="445" loading="eager" fetchpriority="high" decoding="async" />
                <figcaption class="ticket-tag">Rute unggulan · 016</figcaption>
              </div>
              <div class="flex items-center justify-between gap-3 px-5 pt-4">
                <p class="ticket-mono">Boarding pass</p>
                <p class="ticket-mono">Jalan malam</p>
              </div>
              <div class="flex items-end px-5 pb-4 pt-3">
                <div>
                  <p class="ticket-mono">JMB</p>
                  <p class="mt-1.5 text-2xl font-black leading-none">Jambi</p>
                </div>
                <span class="ticket-arrow" aria-hidden="true"></span>
                <div class="text-right">
                  <p class="ticket-mono">PDG</p>
                  <p class="mt-1.5 text-2xl font-black leading-none">Padang</p>
                </div>
              </div>
              <div class="ticket-rule mx-5" aria-hidden="true"></div>
              <dl class="ticket-grid">
                <div><dt class="ticket-mono">Jadwal</dt><dd class="ticket-value">{lead.desc}</dd></div>
                <div><dt class="ticket-mono">Tarif / kursi</dt><dd class="ticket-value">{lead.price}</dd></div>
                <div><dt class="ticket-mono">Jam layanan</dt><dd>{business.hours}</dd></div>
                <div><dt class="ticket-mono">Status</dt><dd>{lead.status}</dd></div>
              </dl>
              <div class="ticket-perf" aria-hidden="true"></div>
              <div class="ticket-stub px-5 pb-5 pt-6">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <p class="ticket-mono">Kode pesan · WA {business.phoneDisplay}</p>
                  <p class="ticket-mono">Gate · Rawasari</p>
                </div>
                <div class="ticket-barcode" aria-hidden="true"></div>
                <p class="ticket-mono mt-2">LND 016 · JMB → PDG · 1600</p>
                <p class="ticket-soft mt-4">{business.address}</p>
              </div>
            </figure>
          </div>
          <p class="mt-4 text-xs text-zinc-500">Sumber: traveljambipadang.web.id (situs resmi).</p>
        </div>
      </div>
    </div>
    <div class="hero-tear" aria-hidden="true"></div>
  </section>

  <!-- Ref: Shakuro Umrah&Hajj tour — 02 Rute populer: tabel desktop / cards mobile -->
  <section class="max-w-7xl mx-auto px-4 py-12 md:py-20 w-full">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-red-800">02 — Rute populer</p>
        <h2 class="mt-2 text-2xl md:text-3xl tracking-tight font-black">Rute jalan malam</h2>
      </div>
      <a href="/jadwal" class="text-sm font-medium text-red-800 underline underline-offset-4 shrink-0">Linimasa lengkap</a>
    </div>
    <div class="mt-6 hidden md:block bg-white border border-red-800/15 rounded-[2rem] overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-zinc-950 text-zinc-100">
          <tr class="text-left"><th scope="col" class="py-3.5 px-5 font-semibold">Rute</th><th scope="col" class="py-3.5 px-5 font-semibold">Jam</th><th scope="col" class="py-3.5 px-5 font-semibold">Harga</th><th scope="col" class="py-3.5 px-5 font-semibold">Status</th><th scope="col" class="py-3.5 px-5 font-semibold"><span class="sr-only">Aksi</span></th></tr>
        </thead>
        <tbody class="divide-y divide-red-800/10">
          {routes.slice(0, 5).map((r, i) => (
            <tr class:list={['transition hover:bg-red-800/5', i % 2 === 1 && 'bg-stone-100/80']}>
              <td class="py-4 px-5 font-semibold">{r.name}</td>
              <td class="py-4 px-5 font-mono-num text-sm whitespace-nowrap">{r.desc}</td>
              <td class="py-4 px-5 font-mono-num font-semibold whitespace-nowrap text-red-800">{r.price}</td>
              <td class="py-4 px-5"><span class={`text-xs font-medium px-3 py-1.5 rounded-full whitespace-nowrap ${r.status.includes('Terverifikasi') ? 'bg-red-800 text-white' : 'bg-amber-100 text-amber-800'}`}>{r.status}</span></td>
              <td class="py-4 px-5 text-right"><a href={waFor(r.name)} target="_blank" rel="noopener" class="inline-block bg-red-800 text-white px-5 py-2 rounded-full text-xs font-semibold whitespace-nowrap">Pesan</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="mt-6 grid grid-cols-1 gap-4 md:hidden">
      {routes.slice(0, 5).map((r, i) => (<RouteCard r={r} wa={waFor(r.name)} index={i} />))}
    </div>
  </section>

  <!-- Ref: Awwwards Fulidhoo Tours travel UI — 03 Armada foto + seat/AC/plus -->
  <section class="max-w-7xl mx-auto px-4 py-12 md:py-20 w-full">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-red-800">03 — Armada</p>
        <h2 class="mt-2 text-2xl md:text-3xl tracking-tight font-black">Kenapa penumpang pilih jalan malam</h2>
      </div>
      <a href="/armada" class="text-sm font-medium text-red-800 underline underline-offset-4 shrink-0">Detail armada</a>
    </div>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      <FleetCard name="Armada Hiace" desc="Kapasitas rombongan dengan AC sehat dan dingin, interior bersih wangi." imgSrc="/images/lnd-rute-1.jpg" w={693} h={445} alt="Armada Hiace LND Travel Jambi Padang" index={0} />
      <FleetCard name="Armada Innova" desc="MPV nyaman untuk rute menengah dengan driver bersertifikat." index={1} />
      <FleetCard name="Paket Kilat" desc="Layanan paket kilat sehari sampai antar kota." index={2} />
    </div>
  </section>

  <!-- Ref: FlowLab booking — 04 Cara pesan 4 langkah + form ringkas -->
  <section class="max-w-7xl mx-auto px-4 py-12 md:py-20 w-full">
    <p class="text-xs font-semibold uppercase tracking-widest text-red-800">04 — Cara pesan</p>
    <h2 class="mt-2 text-2xl md:text-3xl tracking-tight font-black">Pilih → Isi form → WA → Tiba H−30 menit</h2>
    <div class="mt-6"><StepsPesan /></div>
    <div class="mt-6 text-center">
      <a href="/pesan" class="inline-flex items-center bg-red-800 text-white px-8 py-3.5 rounded-full font-semibold min-h-[48px] transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Isi form pesan kursi</a>
    </div>
  </section>

  <!-- Ref: Haramain agency — 05 FAQ + Kontak loket -->
  <section class="max-w-7xl mx-auto px-4 py-12 md:py-20 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-7">
        <p class="text-xs font-semibold uppercase tracking-widest text-red-800">05 — FAQ</p>
        <h2 class="mt-2 text-2xl md:text-3xl tracking-tight font-black">Sering ditanyakan</h2>
        <div class="mt-4 bg-white border border-red-800/15 rounded-[2rem] px-6 md:px-8">
          <Faq items={[...faqs, ...extraFaqs]} />
        </div>
      </div>
      <div class="md:col-span-5">
        <p class="text-xs font-semibold uppercase tracking-widest text-red-800">Kontak loket</p>
        <h2 class="mt-2 text-2xl md:text-3xl tracking-tight font-black">Chat sekarang, berangkat 16.00</h2>
        <div class="mt-4 bg-zinc-950 text-zinc-100 border border-white/10 rounded-[2rem] p-8">
          <p class="inline-flex items-center gap-2 text-xs font-semibold"><span class="breathing-dot" aria-hidden="true"></span> LOKET RAWASARI</p>
          <p class="mt-3 text-sm text-zinc-400">{business.address}</p>
          <p class="mt-2 text-sm text-zinc-400">{business.hours}</p>
          <p class="mt-4 font-mono-num font-semibold text-lg text-white">{business.phoneDisplay}</p>
          <div class="mt-6 flex flex-col gap-3">
            <a href={cta} target="_blank" rel="noopener" class="bg-red-800 text-white text-center px-6 py-3 rounded-full text-sm font-semibold min-h-[48px] grid place-items-center transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">{business.ctaLabel}</a>
            <a href={business.mapsUrl} target="_blank" rel="noopener" class="border border-white/20 text-center px-6 py-3 rounded-full text-sm font-medium min-h-[48px] grid place-items-center transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Buka Maps</a>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-10">
      <TrustBadges />
    </div>
  </section>
</BaseLayout>
