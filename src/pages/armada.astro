---
import BaseLayout from '../layouts/BaseLayout.astro';
import FleetCard from '../components/FleetCard.astro';
import { business, fleet } from '../data/business';
---
<!-- Ref: Awwwards Fulidhoo Tours travel UI — detail unit minimal -->
<BaseLayout title={`Detail armada Hiace & Innova — ${business.name}`} description="Detail armada LND Travel Jambi Padang: Hiace rombongan AC dingin, Innova driver bersertifikat, paket kilat sehari sampai, rental dan carter harian." canonicalPath="/armada" image="/images/lnd-rute-1.jpg" breadcrumbs={[{ name: 'Armada', path: '/armada' }]}>
  <section class="bg-zinc-950 text-zinc-100">
    <div class="max-w-7xl mx-auto px-4 py-12 md:py-20">
      <p class="text-xs font-semibold uppercase tracking-widest text-red-300">Armada — {fleet.length} layanan</p>
      <h1 class="mt-2 text-4xl md:text-6xl tracking-tight leading-none font-black max-w-[22ch]">Hiace, Innova, dan kunci bagasi yang aman</h1>
      <p class="mt-4 text-base text-zinc-400 max-w-[65ch]">Tiap unit: AC dingin, kabin bersih wangi, asuransi perjalanan, driver bersertifikat. Selain travel: paket kilat sehari sampai, rental dan carter harian.</p>
    </div>
  </section>
  <section class="max-w-7xl mx-auto px-4 py-10 md:py-12 w-full">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <FleetCard name="Armada Hiace" desc="Kapasitas rombongan dengan AC sehat dan dingin, interior bersih wangi." imgSrc="/images/lnd-rute-1.jpg" w={693} h={445} alt="Armada Hiace LND Travel rute Jambi Padang" index={0} />
      <FleetCard name="Armada Innova" desc="MPV nyaman untuk rute menengah dengan driver bersertifikat." index={1} />
      <FleetCard name="Paket Kilat" desc="Layanan paket kilat sehari sampai antar kota." index={2} />
      <FleetCard name="Rental & Carter" desc="Sewa mobil harian dengan armada terbaru — travel, paket, dan carter satu atap." imgSrc="/images/lnd-layanan-1.jpg" w={1024} h={1024} alt="Poster layanan LND: travel, paket kilat, carter mobil" index={3} />
    </div>
    <p class="mt-4 text-xs text-zinc-400">Sumber foto: traveljambipadang.web.id (situs resmi).</p>
  </section>
  <section class="max-w-7xl mx-auto px-4 pb-14 w-full">
    <div class="bg-zinc-950 text-zinc-100 border border-white/10 rounded-[2rem] p-8 md:p-12 md:grid md:grid-cols-12 md:gap-8 md:items-center">
      <div class="md:col-span-8">
        <p class="inline-flex items-center gap-2 text-xs font-semibold"><span class="breathing-dot" aria-hidden="true"></span> Kursi malam ini tersisa</p>
        <h2 class="mt-2 text-2xl md:text-3xl tracking-tight font-black">Amankan kursi 16.00 sebelum penuh</h2>
      </div>
      <div class="md:col-span-4 mt-6 md:mt-0 md:text-right">
        <a href="/pesan" class="inline-flex items-center bg-red-800 text-white px-8 py-3.5 rounded-full font-semibold min-h-[48px] transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Pesan kursi</a>
      </div>
    </div>
  </section>
</BaseLayout>
