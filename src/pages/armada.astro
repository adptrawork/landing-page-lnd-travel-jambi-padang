---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, fleet } from '../data/business';
const imgFile: Record<string, { f: string; w: number; h: number }> = { duo: { f: 'lnd-rute-1.jpg', w: 693, h: 445 }, poster: { f: 'lnd-layanan-1.jpg', w: 1024, h: 1024 } };
---
<BaseLayout title={`Armada — ${business.name}`} description={`Armada ${business.name}: armada Hiace dan Innova, paket kilat, rental mobil`} canonicalPath="/armada" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 pt-12 w-full">
    <p class="text-sm font-medium text-emerald-700">Armada</p>
    <h1 class="mt-2 text-4xl md:text-5xl tracking-tighter leading-none font-bold max-w-[20ch]">Armada, paket kilat, dan carter</h1>
    <p class="mt-4 text-base text-gray-600 max-w-[65ch]">Selain travel antar kota, LND melayani paket kilat sehari sampai serta rental dan carter mobil.</p>
  </section>
  <section class="max-w-7xl mx-auto px-4 py-10 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      {fleet.map((v, i) => (
        <article class:list={['reveal', i % 2 === 0 ? 'md:col-span-7' : 'md:col-span-5']}>
          <div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 h-full">
            <img src={`/images/${imgFile[v.img].f}`} alt={v.name} width={imgFile[v.img].w} height={imgFile[v.img].h} loading="lazy" class="w-full h-60 object-cover rounded-3xl" />
            <h2 class="mt-4 font-semibold text-lg tracking-tight">{v.name}</h2>
            <p class="mt-1 text-base text-gray-600">{v.desc}</p>
          </div>
          <p class="mt-3 text-xs text-zinc-400 px-2">Sumber foto: situs resmi operator — ganti foto asli.</p>
        </article>
      ))}
    </div>
    <div class="mt-8 bg-zinc-950 text-white rounded-[2.5rem] p-8 md:p-10">
      <h2 class="font-semibold text-lg tracking-tight">Fasilitas perjalanan</h2>
      <p class="mt-2 text-sm text-zinc-300">AC sehat dan dingin, interior bersih wangi, driver bersertifikat, asuransi, booking 24 jam.</p>
      <a href="/pesan" class="mt-5 inline-block bg-white text-zinc-950 px-6 py-3 rounded-full text-sm font-medium">Pesan kursi</a>
    </div>
  </section>
</BaseLayout>
