---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, fleet } from '../data/business';
---
<BaseLayout title={`Armada Hiace, Innova & carter — ${business.name}`} description="Armada LND Travel Jambi Padang: Hiace dan Innova terawat, paket kilat sehari sampai, rental dan carter mobil harian." canonicalPath="/armada" image="/images/lnd-rute-1.jpg" breadcrumbs={[{ name: 'Armada', path: '/armada' }]}>
  <section class="bg-zinc-950 text-zinc-100">
    <div class="max-w-6xl mx-auto px-4 py-12">
      <p class="text-xs font-semibold uppercase tracking-widest text-red-300">Armada</p>
      <h1 class="mt-2 text-4xl md:text-6xl tracking-tight leading-none font-black max-w-[22ch]">Hiace, Innova, dan kunci bagasi yang aman</h1>
      <p class="mt-4 text-base text-zinc-400 max-w-[65ch]">Selain travel antar kota: paket kilat sehari sampai, rental dan carter mobil harian.</p>
    </div>
  </section>
  <section class="max-w-6xl mx-auto px-4 py-10 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
      <article class="reveal md:col-span-8">
        <div class="refract bg-zinc-950 text-zinc-100 border border-white/10 rounded-[2rem] p-8 h-full md:flex md:gap-6 md:items-center">
          <img src="/images/lnd-rute-1.jpg" alt="Armada Hiace LND Travel" width="693" height="445" loading="eager" class="w-full md:w-64 h-52 object-cover rounded-3xl shrink-0" />
          <div>
            <h2 class="font-bold text-xl tracking-tight">Armada Hiace</h2>
            <p class="mt-1 text-sm text-zinc-400">Kapasitas rombongan, AC sehat dan dingin, interior bersih wangi.</p>
          </div>
        </div>
      </article>
      <article class="reveal md:col-span-4">
        <div class="bg-white border border-red-800/15 rounded-[2rem] p-8 h-full">
          <h2 class="font-bold text-lg tracking-tight">Armada Innova</h2>
          <p class="mt-1 text-sm text-zinc-600">MPV nyaman rute menengah, driver bersertifikat.</p>
        </div>
      </article>
      <article class="reveal md:col-span-4">
        <div class="bg-white border border-red-800/15 rounded-[2rem] p-8 h-full">
          <h2 class="font-bold text-lg tracking-tight">Paket kilat</h2>
          <p class="mt-1 text-sm text-zinc-600">Sehari sampai antar kota.</p>
        </div>
      </article>
      <article class="reveal md:col-span-8">
        <div class="bg-white border border-red-800/15 rounded-[2rem] p-8 h-full md:flex md:gap-6 md:items-center">
          <img src="/images/lnd-layanan-1.jpg" alt="Poster layanan LND: travel, paket kilat, carter" width="1024" height="1024" loading="lazy" class="w-full md:w-40 h-40 object-cover rounded-3xl shrink-0" />
          <div>
            <h2 class="font-bold text-lg tracking-tight">Rental & carter</h2>
            <p class="mt-1 text-sm text-zinc-600">Sewa mobil harian dengan armada terbaru. {fleet.length} layanan dalam satu atap.</p>
            <a href="/pesan" class="mt-4 inline-block bg-red-800 text-white px-6 py-3 rounded-full text-sm font-semibold transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Pesan kursi</a>
          </div>
        </div>
      </article>
    </div>
    <p class="mt-3 text-xs text-zinc-400">Sumber foto: traveljambipadang.web.id (situs resmi).</p>
  </section>
</BaseLayout>
