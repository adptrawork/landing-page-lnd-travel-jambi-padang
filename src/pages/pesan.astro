---
import BaseLayout from '../layouts/BaseLayout.astro';
import StepsPesan from '../components/StepsPesan.astro';
import { business, routes } from '../data/business';
---
<!-- Ref: FlowLab booking — form validasi + error per kolom, tombol 48px -->
<BaseLayout title={`Pesan kursi 16.00 malam ini — ${business.name}`} description="Form pesan kursi LND Travel Jambi Padang: pilih rute jalan malam, tanggal, jumlah kursi — terkirim rapi via WhatsApp booking 24 jam." canonicalPath="/pesan" image={business.ogImage} breadcrumbs={[{ name: 'Pesan Kursi', path: '/pesan' }]}>
  <section class="max-w-7xl mx-auto px-4 pt-12 md:pt-20 w-full">
    <p class="text-xs font-semibold uppercase tracking-widest text-red-800">Pesan Kursi</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tight leading-none font-black max-w-[22ch]">Satu form, kursi malam terkunci</h1>
  </section>
  <section class="max-w-7xl mx-auto px-4 py-10 md:py-12 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
      <form id="book" novalidate class="md:col-span-7 reveal bg-white border border-red-800/15 rounded-[2rem] p-6 md:p-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div class="flex flex-col gap-1.5">
            <label for="f-nama" class="font-medium">Nama penumpang</label>
            <input id="f-nama" name="nama" placeholder="Nama penumpang" autocomplete="name" class="field font-normal border border-zinc-300 rounded-2xl px-4 py-3 focus:border-red-800 focus:outline-none" aria-describedby="e-nama" />
            <p id="e-nama" class="hidden text-xs text-red-700">Isi nama penumpang.</p>
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="f-nowa" class="font-medium">No. WA aktif</label>
            <input id="f-nowa" name="nowa" inputmode="tel" placeholder="08xx" autocomplete="tel" class="field font-normal border border-zinc-300 rounded-2xl px-4 py-3 focus:border-red-800 focus:outline-none" aria-describedby="e-nowa" />
            <p id="e-nowa" class="hidden text-xs text-red-700">Isi no. WA diawali 08, minimal 9 digit.</p>
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="f-rute" class="font-medium">Rute</label>
            <select id="f-rute" name="rute" class="field font-normal border border-zinc-300 rounded-2xl px-4 py-3 focus:border-red-800 focus:outline-none" aria-describedby="e-rute">
              <option value="">— Pilih rute —</option>
              {routes.map((r) => (<option value={r.name}>{r.name} — {r.price}</option>))}
            </select>
            <p id="e-rute" class="hidden text-xs text-red-700">Pilih salah satu rute.</p>
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="f-tanggal" class="font-medium">Tanggal berangkat</label>
            <input id="f-tanggal" name="tanggal" type="date" class="field font-normal border border-zinc-300 rounded-2xl px-4 py-3 focus:border-red-800 focus:outline-none" aria-describedby="e-tanggal" />
            <p id="e-tanggal" class="hidden text-xs text-red-700">Pilih tanggal hari ini atau sesudahnya.</p>
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="f-jumlah" class="font-medium">Jumlah kursi</label>
            <input id="f-jumlah" name="jumlah" type="number" min="1" max="30" value="1" class="field font-normal border border-zinc-300 rounded-2xl px-4 py-3 focus:border-red-800 focus:outline-none" aria-describedby="e-jumlah" />
            <p id="e-jumlah" class="hidden text-xs text-red-700">Jumlah kursi 1–30.</p>
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="f-jemput" class="font-medium">Titik jemput <span class="text-zinc-400 font-normal">(opsional)</span></label>
            <input id="f-jemput" name="jemput" placeholder="cth: Rawasari / alamat" class="field font-normal border border-zinc-300 rounded-2xl px-4 py-3 focus:border-red-800 focus:outline-none" />
          </div>
        </div>
        <p id="book-err" role="alert" class="hidden mt-4 text-sm text-red-700 bg-red-50 border border-red-200 rounded-2xl px-4 py-3">Ada kolom belum valid — periksa pesan merah di tiap kolom.</p>
        <button type="submit" class="mt-6 w-full sm:w-auto bg-red-800 text-white px-7 py-3.5 rounded-full text-sm font-semibold min-h-[48px] transition duration-300 hover:-translate-y-0.5 active:scale-[0.97]">Kirim pesanan via WA</button>
      </form>
      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
          const form = document.getElementById('book');
          const setErr = (id, bad) => {
            document.getElementById(id)?.classList.toggle('hidden', !bad);
            document.querySelector(`[aria-describedby="${id}"]`)?.classList.toggle('field-error', bad);
          };
          form?.addEventListener('submit', (e) => {
            e.preventDefault();
            const fd = new FormData(form);
            const nama = String(fd.get('nama') || '').trim();
            const nowa = String(fd.get('nowa') || '').replace(/[\s-]/g, '');
            const rute = String(fd.get('rute') || '');
            const tgl = String(fd.get('tanggal') || '');
            const jumlah = Number(fd.get('jumlah') || 0);
            const jemput = String(fd.get('jemput') || '').trim();
            const today = new Date().toISOString().slice(0, 10);
            const b = [nama.length < 2, !/^08\d{7,14}$/.test(nowa), !rute, !tgl || tgl < today, !(jumlah >= 1 && jumlah <= 30)];
            ['e-nama', 'e-nowa', 'e-rute', 'e-tanggal', 'e-jumlah'].forEach((id, i) => setErr(id, b[i]));
            const anyBad = b.some(Boolean);
            document.getElementById('book-err')?.classList.toggle('hidden', !anyBad);
            if (anyBad) return;
            window.open('https://wa.me/6281381182008?text=' + encodeURIComponent('Halo LND Travel, saya mau pesan kursi. Rute: ' + rute + ', tanggal ' + tgl + ', ' + jumlah + ' kursi. Nama: ' + nama + ', WA: ' + nowa + (jemput ? ', jemput di: ' + jemput : '') + '. Apakah tersedia untuk 16.00?'), '_blank');
          });
        });
      </script>
      <div class="md:col-span-5 reveal reveal-d1">
        <div class="bg-zinc-950 text-zinc-100 border border-white/10 rounded-[2rem] p-8 h-full">
          <h2 class="font-bold text-lg tracking-tight">Alur pesan 4 langkah</h2>
          <ol class="mt-4 list-none space-y-4 text-sm">
            <li class="flex gap-3"><span class="font-mono-num font-semibold text-red-300">01</span> Pilih rute jalan malam.</li>
            <li class="flex gap-3"><span class="font-mono-num font-semibold text-red-300">02</span> Isi form dengan data valid.</li>
            <li class="flex gap-3"><span class="font-mono-num font-semibold text-red-300">03</span> Admin 24 jam kunci kursi 16.00.</li>
            <li class="flex gap-3"><span class="font-mono-num font-semibold text-red-300">04</span> Tiba H−30 menit di titik jemput.</li>
          </ol>
        </div>
      </div>
    </div>
    <div class="mt-8"><StepsPesan /></div>
  </section>
</BaseLayout>
