---
const steps = [
  { t: 'Pilih rute', d: 'Cek tabel rute jalan malam, catat tujuan dan tanggal berangkatmu.' },
  { t: 'Isi form', d: 'Lengkapi nama, no. WA, rute, tanggal, dan jumlah kursi di form pesan.' },
  { t: 'Kirim via WA', d: 'Pesanan terkirim rapi ke WA booking 24 jam — admin kunci kursi 16.00.' },
  { t: 'Tiba H−30 menit', d: 'Datang 30 menit sebelum 16.00, bawa bukti bayar dan KTP.' },
];
---
<!-- Ref: Dribbble FlowLab Hajj&Umrah booking — booking flow jelas 4 langkah -->
<ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 list-none">
  {steps.map((s, i) => (
    <li class="reveal bg-white border border-red-800/15 rounded-[1.5rem] p-6 transition duration-300 hover:-translate-y-1 hover:border-red-800/40">
      <p class="font-mono-num text-sm font-semibold text-red-800">0{i + 1}</p>
      <h3 class="mt-2 font-bold tracking-tight">{s.t}</h3>
      <p class="mt-1 text-sm text-zinc-600">{s.d}</p>
    </li>
  ))}
</ol>
